{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/lander", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/mvpclub", "destination": "/mvpclub.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
