{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/lander", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/mvpclub", "destination": "/mvpclub.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/newsletter", "schedule": "0 15 * * 2" },
    { "path": "/api/newsletter", "schedule": "0 15 * * 4" }
  ]
}
